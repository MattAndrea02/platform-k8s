          "attributes": {
            "id": "80a0452b708c1e51",
            "meta_data": "\"instance-id\": \"worker-1\"\n\"local-hostname\": \"worker-1\"\n",
            "name": "worker-1-cloudinit",
            "network_config": null,
            "path": "/tmp/terraform-provider-libvirt-cloudinit/cloudinit-80a0452b708c1e51.iso",
            "size": 45056,
            "user_data": "#cloud-config\nhostname: worker-1\nmanage_etc_hosts: false\nssh_pwauth: true\nusers:\n  - name: root\n    ssh_authorized_keys:\n      - ssh-rsa  obbaloo@obbaloo\n    lock_passwd: false\n    passwd: $6$.NO1xMXBmPli7nXx$flG9pE.4yUaMKSIQ8w7yXWpxkXxXrfW7eUH7zTIT4wYR2WeVuV/14NEfPJqfwnI/BSjRt/DEn6eDcU8laaZ6Q1\n    shell: /bin/bash\n  - name: master\n    ssh_authorized_keys:\n      - ssh-rsa  obbaloo@obbaloo\n    lock_passwd: false\n    # the password is generated using: mkpasswd -m sha-512 \"1234\"\n    passwd: $6$.NO1xMXBmPli7nXx$flG9pE.4yUaMKSIQ8w7yXWpxkXxXrfW7eUH7zTIT4wYR2WeVuV/14NEfPJqfwnI/BSjRt/DEn6eDcU8laaZ6Q1\n    sudo: ['ALL=(ALL) NOPASSWD:ALL']\n    shell: /bin/bash\n    groups: wheel\n\ndisable_root: false\nchpasswd:\n  expire: false\nwrite_files:\n  - path: /etc/ssh/sshd_config.d/00-root-login.conf\n    owner: root:root\n    permissions: '0644'\n    content: |\n      PermitRootLogin yes\n      PasswordAuthentication yes\n  - path: /etc/profile.d/kubernetes.sh\n    owner: root:root\n    permissions: '0644'\n    content: |\n      if [ \"$(id -u)\" -eq 0 ]; then\n        export KUBECONFIG=/etc/kubernetes/admin.conf\n      fi\n\npackage_update: true\npackage_upgrade: true\npackages:\n  - curl\n  - wget\n  - apt-transport-https \n  - ca-certificates \n  - gpg\nruncmd:\n  - [sh, -c, 'sshd -t \u0026\u0026 systemctl reload ssh']\n  - curl -fsSL https://pkgs.k8s.io/core:/stable:/v1.37/deb/Release.key | sudo gpg --dearmor -o /etc/apt/keyrings/kubernetes-apt-keyring.gpg\n  - echo 'deb [signed-by=/etc/apt/keyrings/kubernetes-apt-keyring.gpg] https://pkgs.k8s.io/core:/stable:/v1.37/deb/ /' | sudo tee /etc/apt/sources.list.d/kubernetes.list\n  - sudo apt-get update -y\n  - sudo apt-get install kubelet kubeadm -y\n  - sudo apt-mark hold kubelet kubeadm\n  - sudo systemctl enable --now kubelet\n  - echo \"net.ipv4.ip_forward = 1\" | sudo tee /etc/sysctl.d/99-ip-forward.conf   \n  - sysctl --system\n  - sudo apt install containerd -y\n"
          },
          "sensitive_attributes": []
        }
      ]
    },
